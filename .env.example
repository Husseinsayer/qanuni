# ===== Iraqi Legal Platform - Environment Variables =====

# Database — SQLite for dev, switch to PostgreSQL for production
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret"

# AI Configuration (OpenAI-compatible API)
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Install token (for /api/install endpoint)
INSTALL_SECRET="change-this-install-secret"

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INSTALLED="true"

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Email SMTP (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
